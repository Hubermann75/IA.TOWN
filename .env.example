# Gemini is opt-in. Keep this secret in the server environment only; never add it to VITE_* variables.
# The agent runtime stays disabled unless IA_TOWN_GEMINI_ENABLED is explicitly set to true.
IA_TOWN_GEMINI_ENABLED="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
